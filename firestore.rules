rules_version = '2';
// Peraturan keselamatan Firestore untuk Hab Kokurikulum.
// PENTING: gantikan emel.anda@moe-dl.edu.my di bawah dengan e-mel pentadbir yang SAMA seperti dalam koko-config.json.
// (Boleh letak lebih daripada satu: ['a@moe-dl.edu.my', 'b@moe-dl.edu.my'])
service cloud.firestore {
  match /databases/{database}/documents {

    function pentadbirAsal() { return ['g-82034099a@moe-dl.edu.my']; }

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function emel() { return request.auth.token.email.lower(); }
    function isBoot() { return signedIn() && emel() in pentadbirAsal(); }
    function myDoc() { return /databases/$(database)/documents/pengguna/$(request.auth.uid); }
    function me() { return get(myDoc()).data; }
    function approved() { return isBoot() || (signedIn() && exists(myDoc()) && me().get('status', '') == 'lulus'); }
    function isAdmin() { return isBoot() || (approved() && me().get('admin', false) == true); }
    function canWrite() { return isAdmin() || (approved() && me().get('peranan', 'guru') != 'lihat'); }

    // Senarai pengguna hab (kelulusan & peranan)
    match /pengguna/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || approved());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nama', 'emel', 'foto', 'status', 'admin', 'peranan', 'guru', 'createdAt', 'lastSeen'])
        && request.resource.data.emel == emel()
        && request.resource.data.admin == isBoot()
        && request.resource.data.peranan == 'guru'
        && (request.resource.data.status == 'menunggu'
            || (request.resource.data.status == 'lulus'
                && (isBoot() || exists(/databases/$(database)/documents/jemputan/$(emel())))));
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'nama', 'foto']));
      allow delete: if isAdmin();
    }

    // Jemputan e-mel (diluluskan automatik semasa log masuk pertama)
    match /jemputan/{e} {
      allow get: if signedIn() && (emel() == e || isAdmin());
      allow list, write: if isAdmin();
    }

    // Tetapan hab: semua guru boleh baca, hanya pentadbir boleh ubah
    match /config/{id} {
      allow read: if approved();
      allow write: if isAdmin();
    }

    // Data kokurikulum
    match /{col}/{id} {
      allow read: if approved() && col in ['records', 'members', 'reports', 'olahraga', 'olahraga_acara',
                                            'olahraga_daftar', 'pajsk', 'pajsk_rekod', 'log'];
      allow write: if canWrite() && col in ['records', 'members', 'reports', 'olahraga', 'olahraga_acara',
                                             'olahraga_daftar', 'pajsk', 'pajsk_rekod', 'log'];
    }
  }
}
